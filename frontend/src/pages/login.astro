---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Iniciar Sesión">
  <div class="login-shell" data-page="login">
    <aside class="login-brand-panel">
      <div class="login-brand"><span class="login-brand-mark">P</span><span><strong>UVAQ Parking</strong><small>Universidad Vasco de Quiroga</small></span></div>
      <div class="login-message">
        <p class="login-kicker">CONTROL DE ACCESO</p>
        <h1>Estacionamiento<br /><span>universitario</span></h1>
        <p class="login-description">Administra entradas, visitas y espacios del campus desde un solo punto de control.</p>
      </div>
      <div class="parking-marking" aria-hidden="true"><span></span><span></span><span></span><b>P</b></div>
      <p class="login-campus">Sistema institucional de estacionamiento</p>
    </aside>

    <section class="login-form-panel" aria-labelledby="login-title">
      <div class="login-form-content">
        <p class="login-kicker">ACCESO INSTITUCIONAL</p>
        <h2 id="login-title">Iniciar sesión</h2>
        <p class="login-intro">Ingresa con las credenciales de tu cuenta UVAQ.</p>

        <div id="login-error" class="login-error hidden" role="alert" aria-live="polite">
          <span id="login-error-text">Credenciales incorrectas. Intenta de nuevo.</span>
        </div>

        <form id="loginForm" class="login-form">
          <label for="email">Correo electrónico
            <input type="email" id="email" name="email" placeholder="usuario@uvaq.edu.mx" autocomplete="username" required />
          </label>

          <label for="password">Contraseña
            <span class="password-field">
              <input type="password" id="password" name="password" placeholder="Ingresa tu contraseña" autocomplete="current-password" required />
              <button type="button" id="toggle-password" aria-label="Mostrar contraseña">Mostrar</button>
            </span>
          </label>

          <label class="remember-field" for="remember">
            <input type="checkbox" id="remember" name="remember" />
            <span>Mantener sesión iniciada</span>
          </label>

          <button type="submit" id="login-btn" class="login-submit">Ingresar al sistema</button>
        </form>

        <div class="login-restriction"><strong>Acceso restringido</strong><p>Plataforma exclusiva para personal autorizado. La actividad de acceso queda registrada.</p></div>
        <p class="login-version">Universidad Vasco de Quiroga <span>·</span> Sistema de estacionamiento</p>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  body:has([data-page="login"]) main { width:100% !important; max-width:none !important; min-height:100vh !important; margin:0 !important; padding:28px !important; display:grid; place-items:center; }
  body:has([data-page="login"]) .login-shell { display:grid; grid-template-columns:minmax(0,1.02fr) minmax(420px,.98fr); width:min(100%,1080px); min-height:620px; overflow:hidden; background:#fff; border:1px solid #dce3ed; border-radius:12px; box-shadow:0 16px 48px #12294d14; }
  body:has([data-page="login"]) .login-brand-panel { position:relative; display:flex; flex-direction:column; justify-content:space-between; min-height:620px; overflow:hidden; padding:38px 42px; color:#fff; background:#0033a1; }
  body:has([data-page="login"]) .login-brand { position:relative; z-index:1; display:flex; align-items:center; gap:11px; }
  body:has([data-page="login"]) .login-brand-mark { display:grid; place-items:center; width:40px; height:40px; color:#0033a1; background:#ffce00; border-radius:7px; font-size:21px; font-weight:800; }
  body:has([data-page="login"]) .login-brand strong, body:has([data-page="login"]) .login-brand small { display:block; }
  body:has([data-page="login"]) .login-brand strong { font-size:14px; letter-spacing:-.02em; }
  body:has([data-page="login"]) .login-brand small { margin-top:3px; color:#c9d8f9; font-size:10px; }
  body:has([data-page="login"]) .login-message { position:relative; z-index:1; max-width:410px; margin:64px 0 0; }
  body:has([data-page="login"]) .login-kicker { margin:0 0 12px; color:#0033a1; font-size:10px; font-weight:750; letter-spacing:.15em; }
  body:has([data-page="login"]) .login-brand-panel .login-kicker { color:#ffce00; }
  body:has([data-page="login"]) .login-message h1 { margin:0; color:#fff !important; font-size:clamp(36px,4.2vw,52px); line-height:1.03; letter-spacing:-.05em; }
  body:has([data-page="login"]) .login-message h1 span { color:#ffce00; }
  body:has([data-page="login"]) .login-description { max-width:360px; margin:18px 0 0; color:#d8e4ff; font-size:13px; line-height:1.7; }
  body:has([data-page="login"]) .parking-marking { position:relative; z-index:1; display:flex; align-items:center; gap:12px; width:270px; height:88px; margin-top:26px; border-top:1px solid #ffffff5c; border-bottom:1px solid #ffffff5c; }
  body:has([data-page="login"]) .parking-marking span { width:50px; height:50px; border-right:1px solid #ffffff64; }
  body:has([data-page="login"]) .parking-marking b { display:grid; place-items:center; width:38px; height:48px; margin-left:6px; color:#ffce00; border:1px solid #ffce00; border-radius:5px; font-size:21px; }
  body:has([data-page="login"]) .login-campus { position:relative; z-index:1; margin:32px 0 0; color:#c9d8f9; font-size:10px; }
  body:has([data-page="login"]) .login-form-panel { display:grid; place-items:center; padding:48px 54px; background:#fff; }
  body:has([data-page="login"]) .login-form-content { width:min(100%,360px); }
  body:has([data-page="login"]) .login-form-content h2 { margin:0; color:#17243b; font-size:30px; line-height:1.15; letter-spacing:-.045em; }
  body:has([data-page="login"]) .login-intro { margin:9px 0 28px; color:#68768c; font-size:12px; }
  body:has([data-page="login"]) .login-form { display:grid; gap:19px; }
  body:has([data-page="login"]) .login-form > label { display:grid; gap:8px; color:#34445d; font-size:11px; font-weight:650; }
  body:has([data-page="login"]) .login-form input:not([type="checkbox"]) { width:100%; min-height:46px; padding:0 12px; color:#17243b; background:#fafbfd !important; border:1px solid #d6deea !important; border-radius:6px !important; font-size:12px; }
  body:has([data-page="login"]) .login-form input:focus { border-color:#0033a1 !important; box-shadow:0 0 0 3px #0033a11a !important; }
  body:has([data-page="login"]) .password-field { position:relative; display:block; }
  body:has([data-page="login"]) .password-field input { padding-right:72px !important; }
  body:has([data-page="login"]) .password-field button { position:absolute; top:50%; right:10px; transform:translateY(-50%); padding:5px; color:#0033a1; background:transparent; border:0; font-size:10px; font-weight:700; cursor:pointer; }
  body:has([data-page="login"]) .login-form .remember-field { display:flex; align-items:center; gap:9px; color:#59677d; font-weight:450; }
  body:has([data-page="login"]) .login-form .remember-field input { width:15px; height:15px; margin:0; accent-color:#0033a1; }
  body:has([data-page="login"]) .login-submit { min-height:46px; margin-top:2px; color:#fff; background:#0033a1 !important; border:0; border-radius:6px !important; font-size:12px; font-weight:700; cursor:pointer; }
  body:has([data-page="login"]) .login-submit:hover { background:#002575 !important; }
  body:has([data-page="login"]) .login-submit:disabled { opacity:.65; cursor:wait; }
  body:has([data-page="login"]) .login-restriction { margin-top:25px; padding:13px 15px; background:#f2f5fa; border-left:3px solid #ffce00; }
  body:has([data-page="login"]) .login-restriction strong { color:#263954; font-size:10px; }
  body:has([data-page="login"]) .login-restriction p { margin:4px 0 0; color:#65738a; font-size:10px; line-height:1.55; }
  body:has([data-page="login"]) .login-version { margin:23px 0 0; color:#8792a2; font-size:9px; }
  body:has([data-page="login"]) .login-version span { color:#ffce00; padding:0 4px; }
  body:has([data-page="login"]) .login-error:not(.hidden) { margin:-12px 0 18px; padding:11px 13px; color:#9d352b; background:#fbefed; border:1px solid #f0d5d1; border-radius:6px; font-size:11px; }
  @media(max-width:760px) { body:has([data-page="login"]) main { padding:14px !important; } body:has([data-page="login"]) .login-shell { grid-template-columns:1fr; width:min(100%,520px); min-height:0; } body:has([data-page="login"]) .login-brand-panel { min-height:0; padding:22px 24px 25px; } body:has([data-page="login"]) .login-message { margin:32px 0 0; } body:has([data-page="login"]) .login-message h1 { font-size:34px; } body:has([data-page="login"]) .parking-marking { display:none; } body:has([data-page="login"]) .login-campus { margin:18px 0 0; } body:has([data-page="login"]) .login-form-panel { padding:30px 24px; } }
</style>

<script>
  const form = document.getElementById("loginForm") as HTMLFormElement;
  const togglePassword = document.getElementById("toggle-password") as HTMLButtonElement;
  const passwordInput = document.getElementById("password") as HTMLInputElement;
  const errorDiv = document.getElementById("login-error") as HTMLElement;
  const errorText = document.getElementById("login-error-text") as HTMLElement;
  const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;

  if (form && togglePassword && passwordInput && errorDiv && errorText && loginBtn) {
    errorDiv.classList.add("hidden");
    togglePassword.addEventListener("click", () => {
      const showing = passwordInput.type === "password";
      passwordInput.type = showing ? "text" : "password";
      togglePassword.textContent = showing ? "Ocultar" : "Mostrar";
      togglePassword.setAttribute("aria-label", showing ? "Ocultar contraseña" : "Mostrar contraseña");
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const correo = (document.getElementById("email") as HTMLInputElement).value;
      const contrasena = passwordInput.value;
      errorDiv.classList.add("hidden");
      loginBtn.disabled = true;
      const originalButtonText = loginBtn.textContent;
      loginBtn.textContent = "Verificando…";

      try {
        const response = await fetch("http://localhost:3000/api/auth/login", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ correo, contrasena }),
        });
        const result = await response.json();
        if (response.ok) {
          localStorage.setItem("token", result.token);
          localStorage.setItem("user", JSON.stringify(result.user));
          window.location.href = result.user.role === "Administrador" ? "/dashboard" : "/vehiculos";
        } else {
          errorText.textContent = result.message || "Credenciales incorrectas.";
          errorDiv.classList.remove("hidden");
        }
      } catch {
        errorText.textContent = "Error de conexión con el servidor.";
        errorDiv.classList.remove("hidden");
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = originalButtonText || "Ingresar al sistema";
      }
    });
  }
</script>
