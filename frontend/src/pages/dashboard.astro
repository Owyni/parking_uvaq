---
import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';

const currentDate = new Date().toLocaleDateString('es-ES');
---

<Layout title="Dashboard">

  <!-- Header del Dashboard -->
  <section class="mb-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">Dashboard</h1>
        <p class="text-sm text-gray-500 mt-1">Resumen general del sistema de estacionamiento</p>
      </div>
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-1.5">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          <span class="text-xs font-medium text-green-700">En línea</span>
        </div>
        <span class="text-xs text-gray-400" id="clock">--/--/----</span>
      </div>
    </div>
  </section>

  <!-- Tarjetas de estadísticas principales -->
  <StatCard title="Total" value="150" subtitle="Espacios Totales" iconColor="blue">
  <svg>...</svg>
</StatCard>

  <!-- Sección principal -->
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">

    <!-- Gráfica de ocupación -->
    <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6 md:p-8">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-lg font-bold text-gray-900">Ocupación por Hora</h2>
          <p class="text-sm text-gray-500 mt-0.5">Distribución de vehículos durante el día</p>
        </div>
        <div class="flex items-center gap-2">
          <button class="text-xs font-medium text-gray-500 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-lg transition-colors">Hoy</button>
          <button class="text-xs font-medium text-white bg-blue-600 px-3 py-1.5 rounded-lg">Semana</button>
          <button class="text-xs font-medium text-gray-500 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-lg transition-colors">Mes</button>
        </div>
      </div>

      <!-- Gráfica placeholder -->
      <div class="relative w-full h-56 md:h-64">
        <!-- Barras de la gráfica -->
        <div class="absolute inset-0 flex items-end justify-between gap-2 px-2">
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 20%"></div>
            <span class="text-[10px] text-gray-400">6am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 45%"></div>
            <span class="text-[10px] text-gray-400">7am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 75%"></div>
            <span class="text-[10px] text-gray-400">8am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-600 to-indigo-500 rounded-t-lg" style="height: 95%"></div>
            <span class="text-[10px] text-gray-400">9am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-600 to-indigo-500 rounded-t-lg" style="height: 90%"></div>
            <span class="text-[10px] text-gray-400">10am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 80%"></div>
            <span class="text-[10px] text-gray-400">11am</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 60%"></div>
            <span class="text-[10px] text-gray-400">12pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 50%"></div>
            <span class="text-[10px] text-gray-400">1pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 65%"></div>
            <span class="text-[10px] text-gray-400">2pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 70%"></div>
            <span class="text-[10px] text-gray-400">3pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 55%"></div>
            <span class="text-[10px] text-gray-400">4pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-500 to-blue-400 rounded-t-lg" style="height: 35%"></div>
            <span class="text-[10px] text-gray-400">5pm</span>
          </div>
          <div class="flex-1 flex flex-col items-center gap-1">
            <div class="w-full bg-gradient-to-t from-blue-400 to-blue-300 rounded-t-lg" style="height: 15%"></div>
            <span class="text-[10px] text-gray-400">6pm</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Actividad reciente (1 columna) -->
    <div class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-lg font-bold text-gray-900">Actividad Reciente</h2>
        <a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-700 transition-colors">Ver todo</a>
      </div>

      <div class="space-y-4">
        <!-- Entrada -->
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">ABC-1234</p>
            <p class="text-xs text-gray-500">Entrada - Juan Pérez</p>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">8:32 AM</span>
        </div>

        <!-- Salida -->
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">XYZ-5678</p>
            <p class="text-xs text-gray-500">Salida - María López</p>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">8:28 AM</span>
        </div>

        <!-- Entrada -->
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">DEF-9012</p>
            <p class="text-xs text-gray-500">Entrada - Carlos Ruiz</p>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">8:15 AM</span>
        </div>

        <!-- Entrada -->
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-green-50 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">GHI-3456</p>
            <p class="text-xs text-gray-500">Entrada - Ana Torres</p>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">8:02 AM</span>
        </div>

        <!-- Salida -->
        <div class="flex items-start gap-3 p-3 rounded-xl hover:bg-gray-50 transition-colors">
          <div class="w-9 h-9 rounded-lg bg-red-50 flex items-center justify-center flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-gray-900 truncate">JKL-7890</p>
            <p class="text-xs text-gray-500">Salida - Roberto Díaz</p>
          </div>
          <span class="text-xs text-gray-400 flex-shrink-0">7:54 AM</span>
        </div>
      </div>
    </div>

  </section>

  <!-- Tabla de vehículos actualmente en el estacionamiento -->
  <section class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6 md:p-8 mb-10">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
      <div>
        <h2 class="text-lg font-bold text-gray-900">Vehículos en Estacionamiento</h2>
        <p class="text-sm text-gray-500 mt-0.5">Vehículos actualmente dentro del campus</p>
      </div>
      <div class="flex items-center gap-3">
        <!-- Buscador -->
        <div class="relative">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input type="text" placeholder="Buscar placa..." class="pl-9 pr-4 py-2 text-sm bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-300 transition-all w-48" />
        </div>
        <!-- Filtro -->
        <button class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 bg-gray-50 border border-gray-200 px-4 py-2 rounded-xl hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
          </svg>
          Filtrar
        </button>
      </div>
    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-gray-100">
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3 pl-4">Placa</th>
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3">Propietario</th>
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3">Tipo</th>
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3">Hora Entrada</th>
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3">Duración</th>
            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider pb-3 pr-4">Estado</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-50">
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 pl-4">
              <span class="text-sm font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">ABC-1234</span>
            </td>
            <td class="py-3.5">
              <div>
                <p class="text-sm font-medium text-gray-900">Juan Pérez</p>
                <p class="text-xs text-gray-400">Estudiante</p>
              </div>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">Sedán</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">8:32 AM</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">2h 15min</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Activo
              </span>
            </td>
          </tr>
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 pl-4">
              <span class="text-sm font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">DEF-9012</span>
            </td>
            <td class="py-3.5">
              <div>
                <p class="text-sm font-medium text-gray-900">Carlos Ruiz</p>
                <p class="text-xs text-gray-400">Docente</p>
              </div>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">SUV</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">8:15 AM</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">2h 32min</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Activo
              </span>
            </td>
          </tr>
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 pl-4">
              <span class="text-sm font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">GHI-3456</span>
            </td>
            <td class="py-3.5">
              <div>
                <p class="text-sm font-medium text-gray-900">Ana Torres</p>
                <p class="text-xs text-gray-400">Administrativo</p>
              </div>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">Hatchback</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">8:02 AM</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">2h 45min</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Activo
              </span>
            </td>
          </tr>
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 pl-4">
              <span class="text-sm font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">MNO-4567</span>
            </td>
            <td class="py-3.5">
              <div>
                <p class="text-sm font-medium text-gray-900">Laura Méndez</p>
                <p class="text-xs text-gray-400">Estudiante</p>
              </div>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">Sedán</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">7:48 AM</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">2h 59min</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span>
                Prolongado
              </span>
            </td>
          </tr>
          <tr class="hover:bg-gray-50/50 transition-colors">
            <td class="py-3.5 pl-4">
              <span class="text-sm font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">PQR-8901</span>
            </td>
            <td class="py-3.5">
              <div>
                <p class="text-sm font-medium text-gray-900">Miguel Hernández</p>
                <p class="text-xs text-gray-400">Docente</p>
              </div>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">Pickup</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">7:30 AM</span>
            </td>
            <td class="py-3.5">
              <span class="text-sm text-gray-600">3h 17min</span>
            </td>
            <td class="py-3.5 pr-4">
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 px-2.5 py-1 rounded-full">
                <span class="w-1.5 h-1.5 bg-green-500 rounded-full"></span>
                Activo
              </span>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Paginación -->
    <div class="flex items-center justify-between mt-6 pt-4 border-t border-gray-100">
      <p class="text-sm text-gray-500">Mostrando <span class="font-medium text-gray-700">1-5</span> de <span class="font-medium text-gray-700">63</span> vehículos</p>
      <div class="flex items-center gap-1">
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-white bg-blue-600 text-xs font-medium">1</button>
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 text-xs font-medium transition-colors">2</button>
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 text-xs font-medium transition-colors">3</button>
        <span class="text-gray-400 text-xs px-1">...</span>
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-600 hover:bg-gray-100 text-xs font-medium transition-colors">13</button>
        <button class="w-8 h-8 flex items-center justify-center rounded-lg text-gray-400 hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Sección inferior: Distribución por tipo + Acciones rápidas -->
  <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-10">

    <!-- Distribución por tipo de usuario -->
    <div class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6 md:p-8">
      <h2 class="text-lg font-bold text-gray-900 mb-1">Distribución por Tipo</h2>
      <p class="text-sm text-gray-500 mb-6">Vehículos activos clasificados por rol</p>

      <div class="space-y-4">
        <!-- Estudiantes -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Estudiantes</span>
            <span class="text-sm font-semibold text-gray-900">38</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2.5 rounded-full" style="width: 60%"></div>
          </div>
        </div>

        <!-- Docentes -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Docentes</span>
            <span class="text-sm font-semibold text-gray-900">15</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-2.5 rounded-full" style="width: 24%"></div>
          </div>
        </div>

        <!-- Administrativos -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Administrativos</span>
            <span class="text-sm font-semibold text-gray-900">7</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div class="bg-gradient-to-r from-purple-500 to-purple-600 h-2.5 rounded-full" style="width: 11%"></div>
          </div>
        </div>

        <!-- Visitantes -->
        <div>
          <div class="flex items-center justify-between mb-1.5">
