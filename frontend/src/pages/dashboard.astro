---
import Layout from "../layouts/Layout.astro";

---

<Layout title="Dashboard">
  <section class="dashboard-heading mb-8" data-page="dashboard">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div>
        <h1 class="text-2xl md:text-3xl font-extrabold text-gray-900 tracking-tight">
          Operación del estacionamiento
        </h1>
        <p class="text-sm text-gray-500 mt-1">
          Vista en tiempo real de la actividad vehicular del campus.
        </p>
      </div>
      <div class="flex items-center gap-3">
        <div class="inline-flex items-center gap-2 bg-green-50 border border-green-200 rounded-full px-4 py-1.5">
          <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
          <span class="text-xs font-medium text-green-700">En línea</span>
        </div>

        <a href="/registroVisitante" class="dashboard-visit-link">Nueva visita
        </a>

        <span class="text-xs text-gray-400" id="clock">--/--/----</span>
      </div>
    </div>
  </section>

  <section class="dashboard-kpis mb-8" aria-label="Indicadores del estacionamiento">
    <article id="total-espacios-container" class="kpi-card kpi-capacity">
      <span class="kpi-index">CAPACIDAD</span>
      <p class="kpi-value text-2xl font-bold" id="kpi-total">—</p>
      <p class="kpi-label">Espacios totales</p>
    </article>
    <article class="kpi-card kpi-occupied">
      <span class="kpi-index">EN CAMPUS</span>
      <p class="kpi-value text-2xl font-bold" id="kpi-ocupados">—</p>
      <p class="kpi-label">Vehículos dentro</p>
    </article>
    <article class="kpi-card kpi-available">
      <span class="kpi-index">DISPONIBILIDAD</span>
      <p class="kpi-value text-2xl font-bold" id="kpi-disponibles">—</p>
      <p class="kpi-label">Lugares libres</p>
    </article>
    <article class="kpi-card kpi-entries">
      <span class="kpi-index">HOY</span>
      <p class="kpi-value text-2xl font-bold" id="kpi-entradas">—</p>
      <p class="kpi-label">Entradas registradas</p>
    </article>
  </section>

  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    
    <div class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-1">Distribución por Tipo</h2>
      <p class="text-sm text-gray-500 mb-6">Vehículos activos clasificados por rol</p>

      <div class="space-y-4">
        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Estudiantes</span>
            <span class="text-sm font-semibold text-gray-900" id="dist-estudiantes-num">0</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div id="dist-estudiantes-bar" class="bg-gradient-to-r from-blue-500 to-blue-600 h-2.5 rounded-full" style="width: 0%"></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Docentes</span>
            <span class="text-sm font-semibold text-gray-900" id="dist-docentes-num">0</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div id="dist-docentes-bar" class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-2.5 rounded-full" style="width: 0%"></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Administrativos</span>
            <span class="text-sm font-semibold text-gray-900" id="dist-admin-num">0</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div id="dist-admin-bar" class="bg-gradient-to-r from-purple-500 to-purple-600 h-2.5 rounded-full" style="width: 0%"></div>
          </div>
        </div>

        <div>
          <div class="flex items-center justify-between mb-1.5">
            <span class="text-sm font-medium text-gray-700">Visitantes</span>
            <span class="text-sm font-semibold text-gray-900" id="dist-visitantes-num">0</span>
          </div>
          <div class="w-full bg-gray-100 rounded-full h-2.5">
            <div id="dist-visitantes-bar" class="bg-gradient-to-r from-amber-500 to-amber-600 h-2.5 rounded-full" style="width: 0%"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-1">Acciones Rápidas</h2>
      <p class="text-sm text-gray-500 mb-6">Operaciones frecuentes del sistema</p>

      <div class="grid grid-cols-2 gap-3">
        <a href="/control" class="quick-action">
          <span><strong>Registrar entrada</strong><small>Validar vehículo y abrir acceso</small></span>
        </a>

        <a href="/control" class="quick-action">
          <span><strong>Registrar salida</strong><small>Actualizar el acceso activo</small></span>
        </a>

        <a href="/registroVisitante" class="quick-action">
          <span><strong>Dar de alta visita</strong><small>Registrar conductor temporal</small></span>
        </a>

        <a href="/registro" class="quick-action">
          <span><strong>Registrar usuario</strong><small>Asignar perfil institucional</small></span>
        </a>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-lg font-bold text-gray-900">Actividad Reciente</h2>
      </div>
      <div class="space-y-4" id="actividad-reciente"></div>
    </div>

  </section>

  <section class="system-note flex flex-col md:flex-row items-start gap-4">
    <div class="flex-1">
      <h3 class="font-semibold text-gray-900 mb-1">Sistema Operando con Normalidad</h3>
      <p class="text-sm text-gray-600 leading-relaxed">
        Los cambios se reflejarán en tiempo real. No se requieren acciones adicionales por parte del usuario.
      </p>
    </div>
  </section>
</Layout>

<style is:global>
  body:has([data-page="dashboard"]) .dashboard-heading { padding: 8px 0 24px; border-bottom: 1px solid #dfe5ee; }
  body:has([data-page="dashboard"]) .dashboard-heading h1 { max-width: 760px; color: #17243b !important; font-size: clamp(28px,3vw,38px); line-height: 1.15; }
  body:has([data-page="dashboard"]) .dashboard-heading p { max-width: 560px; font-size: 14px; }
  body:has([data-page="dashboard"]) .dashboard-heading > div > div:last-child { align-items: center; }
  body:has([data-page="dashboard"]) .dashboard-kpis { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; }
  body:has([data-page="dashboard"]) .kpi-card { min-height:142px; padding:20px 22px; background:#fff; border:1px solid #dfe5ee; border-radius:12px; }
  body:has([data-page="dashboard"]) .kpi-index { display:block; color:#68768c; font-size:10px; font-weight:700; letter-spacing:.12em; }
  body:has([data-page="dashboard"]) .kpi-value { margin:17px 0 0; color:#0033a1; font-size:34px; line-height:1; font-variant-numeric:tabular-nums; }
  body:has([data-page="dashboard"]) .kpi-label { margin:8px 0 0; color:#67758a; font-size:12px; }
  body:has([data-page="dashboard"]) .kpi-available { background:#fffcf0; border-color:#eedb8d; }
  body:has([data-page="dashboard"]) .kpi-available .kpi-value { color:#0033a1; }
  body:has([data-page="dashboard"]) main section.bg-white { border-radius:12px !important; box-shadow:none !important; }
  body:has([data-page="dashboard"]) main section.grid > div.bg-white { padding:22px; }
  body:has([data-page="dashboard"]) main section.grid > div.bg-white h2 { font-size:16px; }
  body:has([data-page="dashboard"]) #actividad-reciente:empty::after { content:"Sin movimientos recientes"; display:block; padding:24px 0; color:#7b8797; font-size:13px; }
  body:has([data-page="dashboard"]) .dashboard-heading > div { align-items:center; }
  body:has([data-page="dashboard"]) .dashboard-heading > div > div:last-child { display:flex; flex-wrap:wrap; justify-content:flex-end; }
  body:has([data-page="dashboard"]) .dashboard-visit-link { padding:10px 14px; color:#0033a1; background:#ffce00; border-radius:6px; font-size:11px; font-weight:700; text-decoration:none; }
  body:has([data-page="dashboard"]) .dashboard-visit-link:hover { background:#f2c400; }
  body:has([data-page="dashboard"]) .quick-action { display:flex; align-items:center; min-height:65px; padding:12px 14px; color:#1c2d46; background:#f7f9fc; border:1px solid #e5eaf1; border-radius:7px; text-decoration:none; transition:background .16s,border-color .16s; }
  body:has([data-page="dashboard"]) .quick-action:hover { background:#eef3fb; border-color:#cbd8ed; }
  body:has([data-page="dashboard"]) .quick-action strong, body:has([data-page="dashboard"]) .quick-action small { display:block; }
  body:has([data-page="dashboard"]) .quick-action strong { font-size:11px; font-weight:700; }
  body:has([data-page="dashboard"]) .quick-action small { margin-top:4px; color:#718096; font-size:9px; }
  body:has([data-page="dashboard"]) .activity-row { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:11px 0; border-bottom:1px solid #edf0f4; }
  body:has([data-page="dashboard"]) .activity-row:last-child { border-bottom:0; }
  body:has([data-page="dashboard"]) .system-note { padding:18px 21px; color:#53627a; background:#eaf0f8 !important; border:0 !important; border-radius:8px !important; box-shadow:none !important; }
  body:has([data-page="dashboard"]) .system-note h3 { margin:0; color:#263954 !important; font-size:13px; }
  body:has([data-page="dashboard"]) .system-note p { margin:3px 0 0; font-size:11px; }
  @media(max-width:900px) { body:has([data-page="dashboard"]) .dashboard-kpis { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:560px) { body:has([data-page="dashboard"]) .dashboard-kpis { gap:9px; } body:has([data-page="dashboard"]) .kpi-card { min-height:120px; padding:15px; } body:has([data-page="dashboard"]) .kpi-value { font-size:29px; } }
</style>

<script>
  let clockInterval: number;

  const iniciarRelojDashboard = () => {
    const clockElement = document.getElementById("clock");
    if (!clockElement) return;

    clearInterval(clockInterval);

    const actualizarHora = () => {
      const ahora = new Date();
      clockElement.textContent = ahora.toLocaleDateString("es-MX", {
        weekday: "long",
        day: "2-digit",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    };

    actualizarHora();
    clockInterval = window.setInterval(actualizarHora, 1000);
  };

  const cargarDatosDashboard = async () => {
    try {
      const token = localStorage.getItem("token");
      if (!token) {
        window.location.href = "/login";
        return;
      }

      const res = await fetch("http://localhost:3000/api/dashboard/stats", {
        headers: { Authorization: `Bearer ${token}` },
      });

      if (!res.ok) throw new Error("Error al obtener métricas");

      const data = await res.json();

      const totalElement = document.getElementById("kpi-total");
      const ocupadosElement = document.getElementById("kpi-ocupados");
      const disponiblesElement = document.getElementById("kpi-disponibles");
      const entradasElement = document.getElementById("kpi-entradas");
      if (totalElement) totalElement.textContent = String(data.espaciosTotales ?? 0);
      if (ocupadosElement) ocupadosElement.textContent = String(data.vehiculosDentro ?? 0);
      if (disponiblesElement) disponiblesElement.textContent = String(data.espaciosDisponibles ?? 0);
      if (entradasElement) entradasElement.textContent = String(data.entradasHoy ?? 0);

      // 0. Inyectar dinámicamente la capacidad total en la StatCard de Astro
      const totalEspaciosContenedor = document.getElementById(
        "total-espacios-container",
      );
      if (totalEspaciosContenedor && data.espaciosTotales !== undefined) {
        const valueSpan = totalEspaciosContenedor.querySelector(
          ".text-2xl, .text-3xl, font-bold",
        );
        if (valueSpan) {
          valueSpan.textContent = data.espaciosTotales;
        }
      }

      // 1. Inyectar Actividad Reciente
      const contenedorActividad = document.getElementById("actividad-reciente");
      if (contenedorActividad && data.actividadReciente) {
        contenedorActividad.innerHTML = data.actividadReciente
          .map((mov: any) => {
            const horaString = new Date(mov.hora).toLocaleTimeString("es-MX", {
              hour: "2-digit",
              minute: "2-digit",
            });

            return `
            <div class="activity-row">
              <div class="flex-1 min-w-0">
                <p class="text-sm font-medium text-gray-900 truncate">${mov.placa}</p>
                <p class="text-xs text-gray-500">${mov.tipo} - ${mov.propietario}</p>
              </div>
              <span class="text-xs text-gray-400 flex-shrink-0">${horaString}</span>
            </div>
          `;
          })
          .join("");
      }

      // 3. Inyectar Distribución (Cálculo de porcentajes)
      if (data.distribucion && data.vehiculosDentro > 0) {
        const total = data.vehiculosDentro;
        const calcularAncho = (valor: number) =>
          `${Math.round((valor / total) * 100)}%`;

        const distConfig = [
          {
            key: "Estudiantes",
            idNum: "dist-estudiantes-num",
            idBar: "dist-estudiantes-bar",
          },
          {
            key: "Docentes",
            idNum: "dist-docentes-num",
            idBar: "dist-docentes-bar",
          },
          {
            key: "Administrativos",
            idNum: "dist-admin-num",
            idBar: "dist-admin-bar",
          },
          {
            key: "Visitantes",
            idNum: "dist-visitantes-num",
            idBar: "dist-visitantes-bar",
          },
        ];

        distConfig.forEach((conf) => {
          const valor = data.distribucion[conf.key] || 0;
          const elNum = document.getElementById(conf.idNum);
          const elBar = document.getElementById(conf.idBar);
          if (elNum) elNum.textContent = valor.toString();
          if (elBar) elBar.style.width = calcularAncho(valor);
        });
      }
    } catch (error) {
      console.error("Error sincronizando el dashboard:", error);
    }
  };

  const initDashboard = () => {
    iniciarRelojDashboard();
    cargarDatosDashboard();

    // TIEMPO REAL: Configuramos un intervalo para que recargue las gráficas y la tabla
    // automáticamente cada 5000 milisegundos (5 segundos).
    setInterval(() => {
      cargarDatosDashboard();
    }, 5000);
  };

  // 💡 SEGURO DE CICLO DE VIDA: Dejamos únicamente el disparador de Astro
  document.addEventListener("astro:page-load", initDashboard);
</script>
