---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bienvenida">

  <!-- Hero Section: Bienvenida principal -->
  <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-blue-900 via-blue-800 to-indigo-900 text-white px-8 md:px-16 py-16 md:py-20 mb-12 shadow-2xl shadow-blue-900/20">
    
    <!-- Elementos decorativos de fondo -->
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-72 h-72 bg-indigo-500/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
    <div class="absolute top-1/2 right-1/4 w-4 h-4 bg-blue-300/30 rounded-full animate-pulse"></div>
    <div class="absolute top-1/3 right-1/3 w-2 h-2 bg-indigo-300/40 rounded-full animate-pulse delay-300"></div>

    <div class="relative z-10 max-w-3xl">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-4 py-1.5 mb-6">
        <span class="w-2 h-2 bg-green-400 rounded-full animate-pulse"></span>
        <span class="text-xs font-medium text-blue-100">Sistema Activo</span>
      </div>

      <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight leading-tight mb-4">
        Bienvenido al Sistema de<br />
        <span class="bg-gradient-to-r from-blue-200 to-indigo-200 bg-clip-text text-transparent">Estacionamiento UVAQ</span>
      </h1>
      <p class="text-lg text-blue-100/80 leading-relaxed max-w-2xl mb-8">
        Gestiona el acceso vehicular de la Universidad Vasco de Quiroga de forma rápida, segura y eficiente. 
        Controla registros, monitorea espacios y administra usuarios desde un solo lugar.
      </p>

      <!-- Botones de acción -->
      <div class="flex flex-wrap gap-4">
        <a href="/dashboard" class="inline-flex items-center gap-2 bg-white text-blue-900 font-semibold px-6 py-3.5 rounded-xl hover:bg-blue-50 transition-all duration-200 shadow-lg shadow-black/10 hover:shadow-xl active:scale-[0.98]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
          </svg>
          Ir al Dashboard
        </a>
        <a href="/registro" class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 text-white font-semibold px-6 py-3.5 rounded-xl hover:bg-white/20 transition-all duration-200 active:scale-[0.98]">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
          Registrar Usuario
        </a>
      </div>
    </div>

    <!-- Ilustración decorativa lateral (parking icon grande) -->
    <div class="hidden lg:flex absolute right-12 top-1/2 -translate-y-1/2 opacity-10">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-72 h-72" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="0.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
      </svg>
    </div>
  </section>

  <!-- Sección de estadísticas rápidas -->
  <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-12">
    
    <div class="bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
      <div class="w-11 h-11 rounded-xl bg-blue-50 flex items-center justify-center mb-4 group-hover:bg-blue-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <p class="text-2xl font-bold text-gray-900">--</p>
      <p class="text-sm text-gray-500 mt-1">Usuarios Registrados</p>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
      <div class="w-11 h-11 rounded-xl bg-green-50 flex items-center justify-center mb-4 group-hover:bg-green-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-2xl font-bold text-gray-900">--</p>
      <p class="text-sm text-gray-500 mt-1">Espacios Disponibles</p>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
      <div class="w-11 h-11 rounded-xl bg-amber-50 flex items-center justify-center mb-4 group-hover:bg-amber-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <p class="text-2xl font-bold text-gray-900">--</p>
      <p class="text-sm text-gray-500 mt-1">Entradas Hoy</p>
    </div>

    <div class="bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-md hover:border-gray-200 transition-all duration-300 group">
      <div class="w-11 h-11 rounded-xl bg-purple-50 flex items-center justify-center mb-4 group-hover:bg-purple-100 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <p class="text-2xl font-bold text-gray-900">--</p>
      <p class="text-sm text-gray-500 mt-1">Reportes del Mes</p>
    </div>

  </section>

  <!-- Sección de accesos rápidos -->
  <section class="mb-12">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Accesos Rápidos</h2>
        <p class="text-sm text-gray-500 mt-1">Accede a las funciones principales del sistema</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      
      <!-- Tarjeta: Registrar Vehículo -->
      <a href="/registro" class="group bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-lg hover:border-blue-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center mb-5 shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-blue-700 transition-colors">Registrar Vehículo</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Agrega un nuevo usuario y su vehículo al sistema de control de acceso.</p>
        <div class="mt-4 flex items-center gap-1 text-sm font-medium text-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span>Ir al registro</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>

      <!-- Tarjeta: Ver Dashboard -->
      <a href="/dashboard" class="group bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-lg hover:border-green-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center mb-5 shadow-lg shadow-green-500/20 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-green-700 transition-colors">Ver Dashboard</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Consulta el estado actual del estacionamiento, entradas y salidas en tiempo real.</p>
        <div class="mt-4 flex items-center gap-1 text-sm font-medium text-green-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span>Ver panel</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>

      <!-- Tarjeta: Historial de Accesos -->
      <a href="/dashboard" class="group bg-white rounded-2xl p-6 shadow-sm shadow-gray-200/50 border border-gray-100 hover:shadow-lg hover:border-purple-200 hover:-translate-y-1 transition-all duration-300">
        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-purple-500 to-violet-600 flex items-center justify-center mb-5 shadow-lg shadow-purple-500/20 group-hover:scale-110 transition-transform duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-base font-semibold text-gray-900 mb-2 group-hover:text-purple-700 transition-colors">Historial de Accesos</h3>
        <p class="text-sm text-gray-500 leading-relaxed">Revisa el historial completo de entradas y salidas del estacionamiento.</p>
        <div class="mt-4 flex items-center gap-1 text-sm font-medium text-purple-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <span>Ver historial</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </div>
      </a>

    </div>
  </section>

  <!-- Sección informativa: Cómo funciona -->
  <section class="bg-white rounded-2xl shadow-sm shadow-gray-200/50 border border-gray-100 p-8 md:p-10 mb-12">
    <div class="text-center mb-10">
      <h2 class="text-xl font-bold text-gray-900">¿Cómo funciona el sistema?</h2>
      <p class="text-sm text-gray-500 mt-2 max-w-lg mx-auto">El proceso de control vehicular es simple y automatizado en tres pasos.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Paso 1 -->
      <div class="text-center">
        <div class="w-14 h-14 rounded-full bg-blue-50 border-2 border-blue-100 flex items-center justify-center mx-auto mb-4">
          <span class="text-lg font-bold text-blue-600">1</span>
        </div>
        <h4 class="font-semibold text-gray-800 mb-2">Registro</h4>
        <p class="text-sm text-gray-500 leading-relaxed">El usuario se registra con sus datos personales y la información de su vehículo.</p>
      </div>

      <!-- Conector -->
      <div class="hidden md:flex items-center justify-center absolute-connector">
        <!-- Paso 2 -->
        <div class="text-center w-full">
          <div class="w-14 h-14 rounded-full bg-indigo-50 border-2 border-indigo-100 flex items-center justify-center mx-auto mb-4">
            <span class="text-lg font-bold text-indigo-600">2</span>
          </div>
          <h4 class="font-semibold text-gray-800 mb-2">Identificación</h4>
          <p class="text-sm text-gray-500 leading-relaxed">Al ingresar, el sistema identifica al usuario mediante su matrícula registrada.</p>
        </div>
      </div>

      <!-- Paso 2 mobile -->
      <div class="text-center md:hidden">
        <div class="w-14 h-14 rounded-full bg-indigo-50 border-2 border-indigo-100 flex items-center justify-center mx-auto mb-4">
          <span class="text-lg font-bold text-indigo-600">2</span>
        </div>
        <h4 class="font-semibold text-gray-800 mb-2">Identificación</h4>
        <p class="text-sm text-gray-500 leading-relaxed">Al ingresar, el sistema identifica al usuario mediante su matrícula registrada.</p>
      </div>

      <!-- Paso 3 -->
      <div class="text-center">
        <div class="w-14 h-14 rounded-full bg-green-50 border-2 border-green-100 flex items-center justify-center mx-auto mb-4">
          <span class="text-lg font-bold text-green-600">3</span>
        </div>
        <h4 class="font-semibold text-gray-800 mb-2">Acceso</h4>
        <p class="text-sm text-gray-500 leading-relaxed">Se autoriza la entrada y se registra automáticamente la hora de acceso al estacionamiento.</p>
      </div>

    </div>
  </section>

  <!-- Banner informativo final -->
  <section class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl border border-blue-100 p-6 md:p-8 flex flex-col md:flex-row items-center gap-6">
    <div class="w-14 h-14 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
      </svg>
    </div>
    <div class="flex-1 text-center md:text-left">
      <h3 class="font-semibold text-gray-900 mb-1">Seguridad y Control Garantizados</h3>
      <p class="text-sm text-gray-600 leading-relaxed">El sistema opera las 24 horas del día, los 7 días de la semana, garantizando el control de acceso y la seguridad de todos los vehículos dentro del campus universitario.</p>
    </div>
  </section>

</Layout>
