---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registro de estudiante">
  <main class="mx-auto max-w-3xl px-5 py-12">
    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-[.18em] text-blue-700">UVAQ Parking</p>
      <h1 class="mt-3 text-3xl font-bold text-slate-900">Registro de estudiante</h1>
      <p class="mt-2 text-sm text-slate-600">Completa tus datos. Serás dirigido a Stripe para pagar la cuota de registro; la cuenta se habilitará únicamente cuando el pago sea confirmado.</p>
    </div>
    <div id="student-alert" class="mb-5 hidden rounded-lg p-4 text-sm" role="alert"></div>
    <form id="student-register-form" class="grid gap-5 rounded-2xl border border-slate-200 bg-white p-6 md:grid-cols-2">
      <label class="grid gap-2 text-sm font-medium text-slate-700">Nombre completo
        <input name="name" autocomplete="name" required maxlength="120" class="rounded-lg border border-slate-300 px-3 py-3" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Matrícula
        <input name="matricula" required maxlength="50" autocomplete="off" class="rounded-lg border border-slate-300 px-3 py-3" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700 md:col-span-2">Correo electrónico
        <input name="correo" type="email" autocomplete="email" required maxlength="254" class="rounded-lg border border-slate-300 px-3 py-3" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Contraseña (mínimo 8 caracteres)
        <input name="contrasena" type="password" autocomplete="new-password" minlength="8" required class="rounded-lg border border-slate-300 px-3 py-3" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Carrera
        <select name="carreraId" class="rounded-lg border border-slate-300 px-3 py-3">
          <option value="">Selecciona una carrera (opcional)</option>
          <option value="1">Sistemas Computacionales</option>
          <option value="2">Derecho</option>
          <option value="3">Medicina</option>
          <option value="4">Arquitectura</option>
        </select>
      </label>
      <div class="md:col-span-2 border-t border-slate-100 pt-5">
        <h2 class="font-semibold text-slate-900">Datos del vehículo (opcional)</h2>
      </div>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Placa
        <input name="placa" maxlength="20" class="rounded-lg border border-slate-300 px-3 py-3 uppercase" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Tipo de vehículo
        <select name="tipoVehiculoId" class="rounded-lg border border-slate-300 px-3 py-3">
          <option value="">Sin vehículo por ahora</option>
          <option value="1">Automóvil</option>
          <option value="2">Motocicleta</option>
          <option value="3">Camioneta</option>
        </select>
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Modelo / línea
        <input name="modelo" maxlength="80" class="rounded-lg border border-slate-300 px-3 py-3" />
      </label>
      <label class="grid gap-2 text-sm font-medium text-slate-700">Color
        <select name="color" class="rounded-lg border border-slate-300 px-3 py-3">
          <option value="">No especificado</option>
          <option value="Blanco">Blanco</option><option value="Negro">Negro</option>
          <option value="Gris">Gris</option><option value="Rojo">Rojo</option>
          <option value="Azul">Azul</option><option value="Otro">Otro</option>
        </select>
      </label>
      <div class="md:col-span-2 flex flex-col gap-3 border-t border-slate-100 pt-5">
        <p class="text-xs leading-5 text-slate-500">El importe se determina en el servidor. Los datos de tu tarjeta se capturan directamente en Stripe; esta aplicación no almacena los datos de tarjeta.</p>
        <button id="student-submit" type="submit" class="rounded-lg bg-blue-700 px-5 py-3.5 font-semibold text-white hover:bg-blue-800 disabled:opacity-50">Continuar al pago seguro</button>
      </div>
    </form>
  </main>
  <script>
    const initStudentRegistration = () => {
      const form = document.getElementById("student-register-form");
      const button = document.getElementById("student-submit");
      const alertBox = document.getElementById("student-alert");
      if (!form || form.dataset.bound === "true") return;
      form.dataset.bound = "true";
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!(form instanceof HTMLFormElement) || !(button instanceof HTMLButtonElement) || !alertBox) return;
        button.disabled = true;
        button.textContent = "Preparando pago...";
        alertBox.className = "mb-5 hidden rounded-lg p-4 text-sm";
        try {
          const formData = new FormData(form);
          const data = Object.fromEntries(formData.entries());
          const api = import.meta.env.PUBLIC_API_URL || "http://localhost:3000";
          const response = await fetch(`${api}/api/payments/stripe/checkout`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data)
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.message || "No se pudo iniciar el pago.");
          if (!result.checkoutUrl || !result.checkoutUrl.startsWith("https://checkout.stripe.com/")) {
            throw new Error("Stripe devolvió una dirección de pago inválida.");
          }
          window.location.assign(result.checkoutUrl);
        } catch (error) {
          alertBox.className = "mb-5 rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700";
          alertBox.textContent = error instanceof Error ? error.message : "Ocurrió un error inesperado.";
          button.disabled = false;
          button.textContent = "Continuar al pago seguro";
        }
      });
    };
    initStudentRegistration();
    document.addEventListener("astro:page-load", initStudentRegistration);
  </script>
</Layout>
