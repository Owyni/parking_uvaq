---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Registro de Visitante">
  <div class="visitor-page" data-page="visitor">
    <header class="visitor-heading">
      <div><p class="visitor-kicker">ADMISIÓN TEMPORAL</p><h1>Registro de visitante</h1><p>Da de alta al conductor y su vehículo antes de autorizar el acceso al campus.</p></div>
      <div class="visitor-ticket" aria-hidden="true"><span>UVAQ</span><strong>VISITA</strong><small>ACCESO VEHICULAR</small></div>
    </header>

    <div id="registro-alert" class="hidden visitor-alert" role="status" aria-live="polite"><span id="registro-alert-text"></span></div>

    <form id="visitanteForm" class="visitor-form">
      <section class="visitor-section">
        <div class="visitor-section-title"><span>01</span><div><h2>Conductor</h2><p>Persona responsable durante su visita</p></div></div>
        <div class="visitor-fields driver-field">
          <label for="name">Nombre completo <em>*</em><input type="text" id="name" name="name" required placeholder="Nombre y apellidos" autocomplete="name" /></label>
        </div>
      </section>
      <section class="visitor-section">
        <div class="visitor-section-title"><span>02</span><div><h2>Vehículo</h2><p>Información para identificarlo en el estacionamiento</p></div></div>
        <div class="visitor-fields">
          <label for="placa">Matrícula <em>*</em><input type="text" id="placa" name="placa" required placeholder="ABC-1234" class="uppercase" autocomplete="off" /></label>
          <label for="modelo">Marca o modelo<input type="text" id="modelo" name="modelo" placeholder="Ej. Versa, Jetta" /></label>
          <label for="tipoVehiculoId">Tipo de vehículo <em>*</em>
            <select id="tipoVehiculoId" name="tipoVehiculoId" required><option value="" disabled selected>Seleccionar tipo</option><option value="1">Automóvil</option><option value="2">Motocicleta</option><option value="3">Camioneta</option></select>
          </label>
          <label for="color">Color
            <select id="color" name="color"><option value="" disabled selected>Seleccionar color</option><option value="Blanco">Blanco</option><option value="Negro">Negro</option><option value="Gris">Gris / plata</option><option value="Rojo">Rojo</option><option value="Azul">Azul</option><option value="Otro">Otro</option></select>
          </label>
        </div>
      </section>
      <footer class="visitor-actions"><a href="/dashboard">Cancelar</a><button type="submit" id="btnSubmit">Registrar visita</button></footer>
    </form>
  </div>
</Layout>

<style is:global>
  body:has([data-page="visitor"]) .visitor-page { max-width:980px; margin:auto; }
  body:has([data-page="visitor"]) .visitor-heading { display:flex; justify-content:space-between; align-items:center; gap:28px; margin:4px 0 26px; }
  body:has([data-page="visitor"]) .visitor-kicker { margin:0 0 9px; color:#0033a1; font-size:10px; font-weight:750; letter-spacing:.15em; }
  body:has([data-page="visitor"]) .visitor-heading h1 { margin:0; font-size:34px; letter-spacing:-.04em; }
  body:has([data-page="visitor"]) .visitor-heading p:last-child { max-width:560px; margin:8px 0 0; color:#68768c; font-size:13px; }
  body:has([data-page="visitor"]) .visitor-ticket { display:grid; min-width:148px; min-height:104px; align-content:center; padding:16px; color:#0033a1; background:#ffce00; border-radius:4px; text-align:center; transform:rotate(2deg); }
  body:has([data-page="visitor"]) .visitor-ticket span { font-size:10px; font-weight:800; letter-spacing:.12em; }
  body:has([data-page="visitor"]) .visitor-ticket strong { font-size:24px; letter-spacing:.04em; }
  body:has([data-page="visitor"]) .visitor-ticket small { font-size:8px; font-weight:700; letter-spacing:.1em; }
  body:has([data-page="visitor"]) .visitor-form { background:#fff; border:1px solid #dce3ed; border-radius:12px; }
  body:has([data-page="visitor"]) .visitor-section { padding:26px 30px; }
  body:has([data-page="visitor"]) .visitor-section + .visitor-section { border-top:1px solid #e6ebf2; }
  body:has([data-page="visitor"]) .visitor-section-title { display:flex; align-items:flex-start; gap:14px; margin-bottom:22px; }
  body:has([data-page="visitor"]) .visitor-section-title > span { color:#0033a1; font-size:11px; font-weight:800; letter-spacing:.12em; padding-top:3px; }
  body:has([data-page="visitor"]) .visitor-section-title h2 { margin:0; color:#19263b; font-size:17px; }
  body:has([data-page="visitor"]) .visitor-section-title p { margin:4px 0 0; color:#77859a; font-size:11px; }
  body:has([data-page="visitor"]) .visitor-fields { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px 22px; padding-left:28px; }
  body:has([data-page="visitor"]) .visitor-fields label { display:grid; gap:7px; color:#405069; font-size:11px; font-weight:650; }
  body:has([data-page="visitor"]) .visitor-fields em { color:#a04132; font-style:normal; }
  body:has([data-page="visitor"]) .visitor-fields input, body:has([data-page="visitor"]) .visitor-fields select { min-height:44px; padding:0 12px; color:#23334b; font-size:13px; }
  body:has([data-page="visitor"]) .driver-field { grid-template-columns:minmax(0,1fr); }
  body:has([data-page="visitor"]) .visitor-actions { display:flex; align-items:center; justify-content:flex-end; gap:20px; padding:19px 30px; border-top:1px solid #e6ebf2; background:#fafbfd; }
  body:has([data-page="visitor"]) .visitor-actions a { color:#64738a; font-size:12px; text-decoration:none; }
  body:has([data-page="visitor"]) .visitor-actions button { min-height:44px; padding:0 22px; color:#fff; background:#0033a1; border:0; border-radius:7px; font-size:12px; font-weight:650; cursor:pointer; }
  body:has([data-page="visitor"]) .visitor-actions button:hover { background:#002575; }
  body:has([data-page="visitor"]) .visitor-alert:not(.hidden) { display:block; margin-bottom:14px; padding:12px 15px; border:1px solid #d5e5d5; background:#f0f7f0; color:#315b38; font-size:12px; }
  @media(max-width:620px) { body:has([data-page="visitor"]) .visitor-heading { align-items:flex-start; } body:has([data-page="visitor"]) .visitor-ticket { min-width:102px; min-height:80px; padding:8px; } body:has([data-page="visitor"]) .visitor-ticket strong { font-size:18px; } body:has([data-page="visitor"]) .visitor-fields { grid-template-columns:1fr; padding-left:0; } body:has([data-page="visitor"]) .visitor-section { padding:21px 18px; } body:has([data-page="visitor"]) .visitor-actions { padding:15px 18px; } }
</style>

<script>
  const initRegistroVisitante = () => {
    const form = document.getElementById("visitanteForm") as HTMLFormElement;
    const alertBox = document.getElementById("registro-alert");
    const alertText = document.getElementById("registro-alert-text");
    const btnSubmit = document.getElementById("btnSubmit") as HTMLButtonElement;

    if (!form) return;

    // 💡 CAMBIO CLAVE: Usar 'onsubmit' en lugar de 'addEventListener' evita 
    // que se clonen los envíos si Astro recarga la página por detrás.
    form.onsubmit = async (e) => {
      e.preventDefault();

      // Ocultar alerta previa y bloquear botón para evitar doble envío manual
      if (alertBox) alertBox.classList.add("hidden");
      if (btnSubmit) btnSubmit.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      const token = localStorage.getItem("token");

      try {
        const response = await fetch("http://localhost:3000/api/usuarios/visitante", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${token}`, 
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          if (alertBox && alertText) {
            alertBox.className = "max-w-3xl mx-auto mb-6 p-4 bg-green-50 border border-green-200 text-green-700 rounded-xl text-sm font-medium flex items-center gap-2";
            alertText.innerHTML = "Visita registrada correctamente. El acceso ya puede validarse en el control.";
          }
          form.reset(); // Limpiamos el formulario para el siguiente
        } else {
          const errorData = await response.json();
          if (alertBox && alertText) {
            alertBox.className = "max-w-3xl mx-auto mb-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm font-medium flex items-center gap-2";
            alertText.innerHTML = errorData.message || "No se pudo registrar la visita. Revisa los datos.";
          }
        }
      } catch (error) {
        if (alertBox && alertText) {
          alertBox.className = "max-w-3xl mx-auto mb-6 p-4 bg-red-50 border border-red-200 text-red-600 rounded-xl text-sm font-medium flex items-center gap-2";
          alertText.innerHTML = "No se pudo conectar con el servidor central.";
        }
      } finally {
        // Desbloquear botón
        if (btnSubmit) btnSubmit.disabled = false;
      }
    };
  };

  // 💡 CAMBIO CLAVE 2: Dejamos ÚNICAMENTE el disparador nativo de Astro
  document.addEventListener("astro:page-load", initRegistroVisitante);
</script>
