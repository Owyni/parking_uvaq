---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Control de Accesos">
  <div data-page="control" class="access-page">
    <header class="access-heading">
      <div>
        <p class="page-kicker">OPERACIÓN · UVAQ</p>
        <h1>Control de accesos</h1>
        <p class="access-intro">Registra una entrada y consulta quién permanece dentro del campus.</p>
      </div>
      <a class="access-shortcut" href="/dashboard">Volver al resumen</a>
    </header>

    <div class="access-layout">
      <section class="entry-panel" aria-labelledby="entry-title">
        <div class="entry-panel-heading">
          <span class="entry-number">01</span>
          <div><h2 id="entry-title">Registrar entrada</h2><p>Identifica el vehículo antes de abrir el acceso.</p></div>
        </div>
        <form id="form-entrada" class="entry-form">
          <div class="field-block">
            <label for="vehiculo-id">Placa o ID del vehículo</label>
            <input type="text" id="vehiculo-id" placeholder="Ej. ABC-1234" required autocomplete="off" />
            <small>Utiliza la matrícula registrada en el sistema.</small>
          </div>
          <div class="field-block">
            <label for="observaciones-entrada">Nota de acceso <span>Opcional</span></label>
            <textarea id="observaciones-entrada" placeholder="Indicación para el personal de acceso" rows="3"></textarea>
          </div>
          <button type="submit" class="entry-submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            Autorizar entrada
          </button>
        </form>
        <div id="mensaje-entrada" class="entry-message hidden" role="status" aria-live="polite"></div>
        <div class="entry-note"><span>Nota</span> La salida se registra desde el listado de vehículos activos.</div>
      </section>

      <section class="occupancy-panel" aria-labelledby="occupancy-title">
        <div class="occupancy-heading">
          <div><p class="page-kicker">ESTADO ACTUAL</p><h2 id="occupancy-title">Vehículos dentro</h2></div>
          <span class="live-label">Actualizado al cargar</span>
        </div>
        <p class="occupancy-help">Confirma la placa y registra la salida para liberar el espacio.</p>
        <div class="occupancy-table-wrap">
          <table>
            <thead><tr><th scope="col">Matrícula</th><th scope="col">Conductor</th><th scope="col">Entrada</th><th scope="col" class="action-col">Acción</th></tr></thead>
            <tbody id="tabla-control-accesos"></tbody>
          </table>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style is:global>
  body:has([data-page="control"]) .access-page { max-width:1180px; margin:auto; }
  body:has([data-page="control"]) .access-heading { display:flex; align-items:end; justify-content:space-between; gap:24px; margin:6px 0 30px; padding-bottom:22px; border-bottom:1px solid #dce3ed; }
  body:has([data-page="control"]) .page-kicker { margin:0 0 8px; color:#0033a1; font-size:10px; font-weight:700; letter-spacing:.14em; }
  body:has([data-page="control"]) .access-heading h1 { margin:0; font-size:34px; line-height:1.12; letter-spacing:-.04em; }
  body:has([data-page="control"]) .access-intro { margin:8px 0 0; color:#68768c; font-size:14px; }
  body:has([data-page="control"]) .access-shortcut { color:#0033a1; font-size:12px; font-weight:600; text-decoration:none; white-space:nowrap; }
  body:has([data-page="control"]) .access-layout { display:grid; grid-template-columns:minmax(290px,.78fr) minmax(0,1.5fr); gap:22px; align-items:start; }
  body:has([data-page="control"]) .entry-panel, body:has([data-page="control"]) .occupancy-panel { padding:26px; background:#fff; border:1px solid #dce3ed; border-radius:12px; }
  body:has([data-page="control"]) .entry-panel { border-top:3px solid #0033a1; }
  body:has([data-page="control"]) .entry-panel-heading { display:flex; gap:13px; align-items:flex-start; padding-bottom:20px; border-bottom:1px solid #e8edf3; }
  body:has([data-page="control"]) .entry-number { color:#0033a1; font-size:12px; font-weight:800; letter-spacing:.08em; }
  body:has([data-page="control"]) .entry-panel h2, body:has([data-page="control"]) .occupancy-panel h2 { margin:0; font-size:18px; }
  body:has([data-page="control"]) .entry-panel-heading p { margin:5px 0 0; color:#718096; font-size:12px; }
  body:has([data-page="control"]) .entry-form { display:grid; gap:20px; padding-top:22px; }
  body:has([data-page="control"]) .field-block { display:grid; gap:7px; }
  body:has([data-page="control"]) .field-block label { color:#33435a; font-size:12px; font-weight:650; }
  body:has([data-page="control"]) .field-block label span { color:#8190a4; font-weight:400; }
  body:has([data-page="control"]) .field-block input, body:has([data-page="control"]) .field-block textarea { padding:12px 13px; font-size:14px; }
  body:has([data-page="control"]) .field-block small { color:#7c899b; font-size:10px; }
  body:has([data-page="control"]) .entry-submit { display:flex; align-items:center; justify-content:center; gap:10px; min-height:46px; color:#fff; background:#0033a1; border:0; border-radius:8px; font-size:13px; font-weight:650; cursor:pointer; }
  body:has([data-page="control"]) .entry-submit:hover { background:#002575; }
  body:has([data-page="control"]) .entry-submit svg { width:18px; height:18px; }
  body:has([data-page="control"]) .entry-message:not(.hidden) { margin-top:14px; padding:11px 13px; background:#edf5ee; border:1px solid #d4e7d5; border-radius:7px; font-size:12px; }
  body:has([data-page="control"]) .entry-note { margin-top:23px; padding:13px; color:#68768c; background:#f5f7fa; font-size:11px; line-height:1.55; }
  body:has([data-page="control"]) .entry-note span { margin-right:6px; color:#0033a1; font-weight:700; }
  body:has([data-page="control"]) .occupancy-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; }
  body:has([data-page="control"]) .occupancy-heading .page-kicker { margin-bottom:5px; }
  body:has([data-page="control"]) .live-label { color:#64738a; font-size:10px; white-space:nowrap; }
  body:has([data-page="control"]) .occupancy-help { margin:7px 0 19px; color:#748197; font-size:12px; }
  body:has([data-page="control"]) .occupancy-table-wrap { overflow-x:auto; }
  body:has([data-page="control"]) .occupancy-panel th { padding:10px 12px; color:#66758b; background:#f5f7fa; text-align:left; font-size:10px; letter-spacing:.08em; text-transform:uppercase; }
  body:has([data-page="control"]) .occupancy-panel td { padding:14px 12px; border-bottom:1px solid #edf0f4; font-size:12px; }
  body:has([data-page="control"]) .occupancy-panel .action-col { text-align:right; }
  body:has([data-page="control"]) .occupancy-panel .btn-salida { color:#0033a1 !important; background:#edf2fb !important; border:1px solid #d8e2f3 !important; border-radius:6px !important; }
  @media(max-width:900px) { body:has([data-page="control"]) .access-layout { grid-template-columns:1fr; } }
  @media(max-width:560px) { body:has([data-page="control"]) .access-heading { align-items:flex-start; flex-direction:column; margin-bottom:20px; } body:has([data-page="control"]) .access-heading h1 { font-size:29px; } body:has([data-page="control"]) .entry-panel, body:has([data-page="control"]) .occupancy-panel { padding:18px; } }
</style>

<script>
  const token = localStorage.getItem('token');
  if (!token) {
    window.location.href = '/login';
  }

  // --- Cargar los vehículos activos dentro del estacionamiento ---
  const cargarVehiculosActivos = async () => {
    try {
      const res = await fetch('http://localhost:3000/api/dashboard/stats', {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) throw new Error('Error al consultar ocupación');
      const data = await res.json();

      const tabla = document.getElementById('tabla-control-accesos');
      if (!tabla) return;

      if (!data.vehiculosEnEstacionamiento || data.vehiculosEnEstacionamiento.length === 0) {
        tabla.innerHTML = `<tr><td colspan="4" class="text-center py-6 text-sm text-gray-400">No hay vehículos dentro en este momento.</td></tr>`;
        return;
      }

      // Nota: Tu controlador de dashboard necesitará retornar el ID del acceso o la placa para poder procesar la salida.
      // Usaremos la placa como identificador único o el ID si lo agregas al mapeo.
      tabla.innerHTML = data.vehiculosEnEstacionamiento.map((v: any) => `
        <tr class="hover:bg-gray-50/50 transition-colors text-sm">
          <td class="py-3.5 pl-4">
            <span class="font-semibold text-gray-900 bg-gray-100 px-2.5 py-1 rounded-lg">${v.placa}</span>
          </td>
          <td class="py-3.5">
            <div>
              <p class="font-medium text-gray-900">${v.propietario}</p>
              <p class="text-xs text-gray-400">${v.rol}</p>
            </div>
          </td>
          <td class="py-3.5 text-gray-600">${v.horaEntrada}</td>
          <td class="py-3.5 pr-4 text-right">
            <button 
              data-placa="${v.placa}" 
              class="btn-salida bg-red-50 hover:bg-red-100 text-red-600 font-medium text-xs px-3 py-1.5 rounded-xl border border-red-200 transition-colors"
            >
              Registrar Salida
            </button>
          </td>
        </tr>
      `).join('');

      // Agregar los listeners a los botones de salida generados
      document.querySelectorAll('.btn-salida').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const placa = (e.target as HTMLButtonElement).getAttribute('data-placa');
          if (placa) procesarSalida(placa);
        });
      });

    } catch (err) {
      console.error('Error cargando controles:', err);
    }
  };

  // --- Ejecutar registro de entrada ---
  const formEntrada = document.getElementById('form-entrada') as HTMLFormElement;
  formEntrada?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const vehiculoId = (document.getElementById('vehiculo-id') as HTMLInputElement).value;
    const observations = (document.getElementById('observaciones-entrada') as HTMLInputElement).value;
    const msg = document.getElementById('mensaje-entrada');

    try {
      const res = await fetch('http://localhost:3000/api/parking/entrada', {
        method: 'POST',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ vehiculoId, observations })
      });

      const data = await res.json();
      if (!msg) return;

      msg.classList.remove('hidden', 'text-green-600', 'text-red-600');
      if (res.ok) {
        msg.textContent = "Entrada registrada.";
        msg.classList.add('text-green-600');
        formEntrada.reset();
        cargarVehiculosActivos(); // Refrescar la tabla
      } else {
        msg.textContent = data.message || 'No se pudo registrar la entrada.';
        msg.classList.add('text-red-600');
      }
    } catch (err) {
      console.error(err);
    }
  });

  // --- Ejecutar registro de salida ---
  const procesarSalida = async (placa: string) => {
    if (!confirm(`¿Confirmar salida del vehículo con placa ${placa}?`)) return;

    try {
      const res = await fetch('http://localhost:3000/api/parking/salida', {
        method: 'PUT',
        headers: { 
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${token}`
        },
        body: JSON.stringify({ placa }) // Enviamos la placa para identificar el acceso activo
      });

      if (res.ok) {
        alert('Salida registrada con éxito.');
        cargarVehiculosActivos(); // Refrescar la tabla
      } else {
        const data = await res.json();
        alert(`Error: ${data.message}`);
      }
    } catch (err) {
      console.error(err);
    }
  };

  // Escuchar el ciclo de vida de Astro para inicializar
  document.addEventListener('astro:page-load', cargarVehiculosActivos);
</script>
