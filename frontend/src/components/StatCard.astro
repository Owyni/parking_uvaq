---
const { title, value, subtitle, iconColor } = Astro.props;
// Aquí puedes hacer un diccionario de colores dinámico basado en Tailwind
---
<div class="bg-white rounded-2xl p-6 shadow-sm border border-gray-100 hover:shadow-md transition-all">
  <div class="flex items-center justify-between mb-4">
    <div class={`w-11 h-11 rounded-xl flex items-center justify-center bg-${iconColor}-50 text-${iconColor}-600`}>
      <slot /> </div>
  </div>
  <p class="text-3xl font-bold text-gray-900">{value}</p>
  <p class="text-sm text-gray-500 mt-1">{subtitle}</p>
</div>