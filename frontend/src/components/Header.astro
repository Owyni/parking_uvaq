---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/dashboard", label: "Resumen" },
  { href: "/registro", label: "Usuarios" },
  { href: "/registroVisitante", label: "Visitantes" },
  { href: "/control", label: "Accesos" },
];
---

<nav aria-label="Navegación principal">
  <div class="header-inner">
    <a href="/" class="brand" title="Ir al inicio">
      <span class="brand-mark" aria-hidden="true">P</span>
      <span class="brand-copy"><strong>UVAQ <span>Parking</span></strong><small>Gestión de estacionamiento</small></span>
    </a>

    <div class="header-links" aria-label="Secciones">
      {links.map((link) => {
        const active = currentPath === link.href;
        return <a href={link.href} aria-current={active ? "page" : undefined} class:list={["nav-link", active && "is-active"]}>{link.label}</a>;
      })}
      <span class="nav-divider" aria-hidden="true"></span>
      <button id="btn-logout" class="nav-logout" type="button">Salir</button>
    </div>
  </div>
</nav>

<style>
  .header-inner { display:flex; align-items:center; justify-content:space-between; gap:24px; }
  .brand { display:flex; align-items:center; gap:11px; color:#fff; text-decoration:none; }
  .brand-mark { display:grid; place-items:center; width:40px; height:40px; color:#0033a1; background:#ffce00; border-radius:7px; font:800 21px/1 Inter,sans-serif; }
  .brand-copy { display:flex; flex-direction:column; gap:3px; }
  .brand-copy strong { color:#fff; font-size:15px; line-height:1.1; letter-spacing:-.03em; }
  .brand-copy strong span { font-weight:500; }
  .brand-copy small { color:#c5d4f5; font-size:10px; letter-spacing:.035em; }
  .header-links { display:flex; align-items:center; gap:5px; }
  .nav-link,.nav-logout { display:flex; align-items:center; justify-content:center; min-height:40px; padding:0 14px; border:1px solid transparent; border-radius:6px; color:#dce6fb; font:500 12px Inter,sans-serif; text-decoration:none; white-space:nowrap; cursor:pointer; }
  .nav-link:hover { color:#fff; background:#ffffff12; }
  .nav-link.is-active { color:#fff; background:#ffffff18; box-shadow:inset 0 -2px #ffce00; }
  .nav-divider { width:1px; height:24px; margin:0 8px; background:#ffffff38; }
  .nav-logout { color:#fff; border-color:#ffffff55; background:transparent; }
  .nav-logout:hover { border-color:#fff; background:#ffffff18; }
  @media(max-width:760px) {
    .header-inner { align-items:flex-start; flex-direction:column; gap:10px; }
    .brand-mark { width:34px; height:34px; font-size:18px; }
    .brand-copy small { display:none; }
    .header-links { width:100%; overflow-x:auto; padding-bottom:2px; }
    .nav-link,.nav-logout { flex:0 0 auto; min-height:36px; padding:0 11px; font-size:11px; }
    .nav-divider { margin:0 3px; }
  }
</style>

<script>
  const initLogout = () => {
    const btnLogout = document.getElementById("btn-logout");
    if (!btnLogout || btnLogout.dataset.ready) return;
    btnLogout.dataset.ready = "true";
    btnLogout.addEventListener("click", () => {
      localStorage.removeItem("token");
      localStorage.removeItem("user");
      window.location.href = "/login";
    });
  };
  initLogout();
  document.addEventListener("astro:page-load", initLogout);
</script>
