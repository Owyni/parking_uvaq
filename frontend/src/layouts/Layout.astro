---
import "../styles/global.css";
import Header from "../components/Header.astro";

import { ClientRouter } from "astro:transitions";

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - UVAQ Parking</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>

  <body
    class="bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 min-h-screen font-sans text-gray-800 antialiased"
  >
    <Header />
    <main class="max-w-7xl mx-auto px-6 py-10 animate-fade-in">
      <slot />
    </main>

    <script>
      const verificarSeguridadFrontend = () => {
        const token = localStorage.getItem("token");
        const userStr = localStorage.getItem("user");
        let user = null;

        if (userStr) {
          try {
            user = JSON.parse(userStr);
          } catch (e) {
            console.error("Error al leer datos del usuario");
          }
        }

        let currentPath = window.location.pathname;
        if (currentPath.endsWith("/") && currentPath !== "/") {
          currentPath = currentPath.slice(0, -1);
        }

        console.log("🔒 [Seguridad] Ruta detectada:", currentPath);

        // 1. Si NO hay token y NO está en el login ni en la bienvenida (/), lo obligamos a ir al login
        if (!token && currentPath !== "/login" && currentPath !== "/") {
          window.location.href = "/login";
          return;
        }

        // 2. Si SÍ hay token, aplicamos las reglas de roles
        if (token && user) {
          // Si intentan ir al login teniendo sesión, los redirigimos a su panel correspondiente
          if (currentPath === "/login") {
            window.location.href =
              user.role === "Administrador" ? "/dashboard" : "/vehiculos";
            return;
          }

          // 3. RESTRICCIÓN PARA NO ADMINISTRADORES (Estudiantes)
          if (user.role !== "Administrador") {
            // Lista de rutas que el estudiante SÍ puede visitar
            const rutasPermitidasEstudiante = ["/vehiculos", "/"];

            // Si intenta entrar a una ruta que no está en su lista permitida, lo devolvemos a /vehiculos
            if (!rutasPermitidasEstudiante.includes(currentPath)) {
              console.warn(
                "Bloqueo de seguridad: Rol no autorizado para esta ruta.",
              );
              window.location.href = "/vehiculos";
              return;
            }
          }
        }
      };

      // REGLA DE ORO PARA CLIENTROUTER:
      // astro:page-load se dispara SIEMPRE: en la primera carga (F5) y en cada clic del menú
      document.addEventListener("astro:page-load", verificarSeguridadFrontend);
    </script>
  </body>
</html>
