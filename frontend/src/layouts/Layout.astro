---
// src/layouts/Layout.astro
import "../styles/global.css"; //
import Header from "../components/Header.astro"; //
import Footer from "../components/Footer.astro"; //

// CAMBIA ESTA LÍNEA:
import { ClientRouter } from "astro:transitions";

const { title } = Astro.props; //
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - UVAQ Parking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>

  <body class="min-h-screen">
    <Header />
    <main class="min-h-screen max-w-7xl mx-auto px-6 py-10"><slot /></main>
    <Footer />
    <script>
      // Esta función se ejecuta cada vez que la página carga
      const checkAuth = () => {
        // Si estamos en la página de inicio o login, no hacemos nada
        if (
          window.location.pathname === "/" ||
          window.location.pathname === "/login"
        )
          return;

        // Buscamos el token que guardamos al hacer login
        const token = localStorage.getItem("token");

        // Si no hay token, lo pateamos de vuelta al inicio
        if (!token) {
          window.location.href = "/login";
        }
      };

      // Ejecutar en la carga normal
      checkAuth();

      // Ejecutar cuando Astro ViewTransitions cambia de página
      document.addEventListener("astro:page-load", checkAuth);
    </script>
  </body>
</html>
